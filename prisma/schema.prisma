datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  role      String   @default("DONOR") // ADMIN, VOLUNTEER, MEMBER, DONOR
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  donor       Donor?
  volunteer   Volunteer?
  member      Member?
}

model Donor {
  id           String   @id @default(uuid())
  userId       String?  @unique
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name         String
  email        String   @unique
  phone        String
  panNumber    String?
  address      String?
  city         String?
  state        String?
  pincode      String?
  totalDonated Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  donations Donation[]
}

model Donation {
  id                String   @id @default(uuid())
  receiptNumber     String   @unique
  donorId           String?
  donor             Donor?   @relation(fields: [donorId], references: [id], onDelete: SetNull)
  donorName         String
  donorEmail        String
  donorPhone        String
  donorPan          String?
  donorAddress      String?
  amount            Float
  cause             String   @default("General Fund")
  campaignId        String?
  campaign          Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  paymentMethod     String   @default("Razorpay")
  paymentStatus     String   @default("SUCCESS") // SUCCESS, PENDING, FAILED
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  receiptPdfUrl     String?
  createdAt         DateTime @default(now())
}

model Volunteer {
  id                String   @id @default(uuid())
  userId            String?  @unique
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name              String
  email             String   @unique
  phone             String
  dob               String?
  address           String?
  city              String?
  occupation        String?
  education         String?
  skills            String   // Comma separated
  availability      String   // Weekdays, Weekends, Full-time, etc.
  interests         String?
  motivation        String?
  profilePhoto      String?
  status            String   @default("PENDING") // PENDING, VERIFIED, APPROVED, REJECTED
  verificationNotes String?
  totalHours        Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  assignments  VolunteerAssignment[]
  attendances  VolunteerAttendance[]
  certificates VolunteerCertificate[]
}

model VolunteerAssignment {
  id           String    @id @default(uuid())
  volunteerId  String
  volunteer    Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  projectId    String?
  activity     Activity? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  eventName    String
  assignedDate DateTime  @default(now())
  status       String    @default("ACTIVE") // ACTIVE, COMPLETED
  notes        String?
}

model VolunteerAttendance {
  id          String    @id @default(uuid())
  volunteerId String
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  projectId   String?
  activity    Activity? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  date        String
  checkIn     String
  checkOut    String
  hoursLogged Float
  status      String    @default("VERIFIED") // SUBMITTED, VERIFIED, REJECTED
  verifiedBy  String?
  createdAt   DateTime  @default(now())
}

model VolunteerCertificate {
  id               String    @id @default(uuid())
  certificateNo    String    @unique
  volunteerId      String
  volunteer        Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  volunteerName    String
  projectName      String
  totalHours       Float
  issueDate        DateTime  @default(now())
  pdfUrl           String?
  authorizedSignee String    @default("Kamla Kumari (President)")
}

model MembershipPlan {
  id             String   @id @default(uuid())
  title          String
  fee            Float
  validityMonths Int      @default(12)
  benefits       String   // Comma or line separated
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  members Member[]
}

model Member {
  id           String         @id @default(uuid())
  userId       String?        @unique
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  membershipNo String         @unique
  planId       String
  plan         MembershipPlan @relation(fields: [planId], references: [id])
  memberName   String
  memberEmail  String
  memberPhone  String
  memberPhoto  String?
  panNumber    String?
  status       String         @default("PENDING") // PENDING, APPROVED, ACTIVE, EXPIRED, REJECTED
  validFrom    DateTime       @default(now())
  validTill    DateTime
  amountPaid   Float
  paymentId    String?
  createdAt    DateTime       @default(now())
}

model Campaign {
  id           String     @id @default(uuid())
  title        String
  slug         String     @unique
  description  String
  targetAmount Float
  raisedAmount Float      @default(0)
  image        String
  status       String     @default("ACTIVE") // ACTIVE, COMPLETED
  category     String     @default("General")
  createdAt    DateTime   @default(now())

  donations Donation[]
}

model Activity {
  id            String   @id @default(uuid())
  title         String
  category      String
  description   String
  location      String
  beneficiaries Int      @default(0)
  date          String
  image         String
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())

  assignments VolunteerAssignment[]
  attendances VolunteerAttendance[]
}

model Event {
  id                   String   @id @default(uuid())
  title                String
  description          String
  venue                String
  eventDate            String
  eventTime            String
  bannerImage          String
  maxVolunteers        Int      @default(10)
  registeredVolunteers Int      @default(0)
  status               String   @default("UPCOMING") // UPCOMING, COMPLETED, CANCELLED
  createdAt            DateTime @default(now())
}

model GalleryItem {
  id        String   @id @default(uuid())
  title     String
  category  String
  mediaType String   @default("image") // image, video
  url       String
  createdAt DateTime @default(now())
}

model BlogPost {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  author      String   @default("Maa Samundri Devi Trust Team")
  category    String   @default("Community")
  image       String
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

model ContactSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String
  subject   String
  message   String
  status    String   @default("NEW") // NEW, READ, REPLIED
  createdAt DateTime @default(now())
}

model NGOInfo {
  id              String   @id @default("1")
  name            String   @default("Maa Samundri Devi Charitable Trust")
  tagline         String   @default("Dedicated to Health, Education, Environment and Social Welfare")
  regNumber       String   @default("Deed No: 16/2024 (Aurangabad)")
  taxExempt80G    String   @default("AALTM2352GF20261")
  taxExempt12A    String   @default("AALTM2352GE20261")
  darpanId        String   @default("BR/2024/0378911")
  panNumber       String   @default("AALTM2352G")
  bankName        String   @default("Central Bank of India")
  accountNumber   String   @default("4156734014")
  ifscCode        String   @default("CBIN0284035")
  branchName      String   @default("S.N. Sinha College, Aurangabad (Bihar)")
  address         String   @default("Pipardih Ward No- 33, Gali No- 04, Aurangabad – 824101, Bihar")
  phone           String   @default("+91 77660 84876")
  email           String   @default("contact@samundridevitrust.org")
  logoUrl         String   @default("/images/trust_stamp.png")
  signatureUrl    String   @default("/images/kamla_kumari_signature.png")
  razorpayKeyId   String   @default("rzp_test_YOUR_KEY_HERE")
  razorpayKeySecret String @default("YOUR_RAZORPAY_SECRET_HERE")
}
